# Dashboard deployment. Copy to .env and keep it out of Git.
BIND_ADDRESS=0.0.0.0
PORT=4310
# Optional DNS authorities in addition to localhost and the receiving interface IP.
# ALLOWED_HOSTS=stream-pc:4310,stream-pc.example:4310
DATA_DIR=.data
# Optional operator credential. Otherwise generated in .data/operator.key.
# ADMIN_TOKEN=replace-with-a-long-random-token
LEASE_MS=30000
HEARTBEAT_MS=5000
PRODUCER_RATE=2
PRODUCER_BURST=10
# Private render inspection uses an installed browser: msedge on Windows, chrome elsewhere.
# RENDER_BROWSER_CHANNEL=msedge
# Optional trusted browser executable, taking precedence over channel selection.
# RENDER_BROWSER_EXECUTABLE=C:/path/to/chrome.exe
# MCP adapter settings on the AI agent computer. Use the dashboard computer's IP.
# Use a producer token, never ADMIN_TOKEN. Keep localhost for same-machine clients.
# DASHBOARD_URL=http://127.0.0.1:4310
# DASHBOARD_PRODUCER_TOKEN=replace-with-a-registered-producer-token
