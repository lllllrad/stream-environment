# Local-only deployment. Copy to .env and keep it out of Git.
PORT=4310
DATA_DIR=.data
# Optional operator credential. Otherwise generated in .data/operator.key.
# ADMIN_TOKEN=replace-with-a-long-random-token
LEASE_MS=30000
HEARTBEAT_MS=5000
PRODUCER_RATE=2
PRODUCER_BURST=10
# Optional local MCP adapter settings. Use a producer token, never ADMIN_TOKEN.
# DASHBOARD_URL=http://127.0.0.1:4310
# DASHBOARD_PRODUCER_TOKEN=replace-with-a-registered-producer-token
