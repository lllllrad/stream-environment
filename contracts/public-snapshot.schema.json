{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublicSnapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "screenId": {
      "type": "string",
      "maxLength": 80
    },
    "preset": {
      "enum": [
        "full",
        "side",
        "lower"
      ]
    },
    "publicRevision": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "auto",
        "hold",
        "hidden"
      ]
    },
    "leaseMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "compact": {
      "type": "boolean"
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "sceneId": {
          "type": "string",
          "maxLength": 80
        },
        "sceneName": {
          "type": "string",
          "maxLength": 60
        },
        "configRevision": {
          "type": "integer",
          "minimum": 0
        },
        "layoutRevision": {
          "type": "integer",
          "minimum": 0
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,59}$"
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 48,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 32,
                "maximum": 2160
              },
              "zIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000,
                "default": 0,
                "description": "Higher values render in front. Equal values use array order, with later widgets in front. Omitted values default to zero for compatibility."
              },
              "visible": {
                "type": "boolean"
              },
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fontSize",
                  "minFontSize",
                  "padding",
                  "maxLines",
                  "overflow",
                  "background",
                  "color",
                  "showDetails",
                  "maxItems",
                  "message",
                  "detail"
                ],
                "properties": {
                  "fontSize": {
                    "type": "integer",
                    "minimum": 12,
                    "maximum": 80
                  },
                  "minFontSize": {
                    "type": "integer",
                    "minimum": 12,
                    "maximum": 80
                  },
                  "padding": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 64
                  },
                  "maxLines": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "overflow": {
                    "enum": [
                      "clip",
                      "ellipsis",
                      "shrink",
                      "scroll"
                    ]
                  },
                  "background": {
                    "type": "string",
                    "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|transparent)$",
                    "description": "Hex RGB/RGBA colors in 3, 4, 6 or 8 digits, or transparent. Alpha is the final digit or pair; shorthand is expanded when saved."
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                    "description": "Hex RGB/RGBA text color in 3, 4, 6 or 8 digits. Alpha is the final digit or pair; shorthand is expanded when saved."
                  },
                  "showDetails": {
                    "type": "boolean"
                  },
                  "maxItems": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "message": {
                    "const": ""
                  },
                  "detail": {
                    "const": ""
                  }
                }
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "role": {
                      "enum": [
                        "heading",
                        "body",
                        "label"
                      ]
                    },
                    "expiresAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "text",
                    "role"
                  ]
                }
              }
            },
            "required": [
              "id",
              "type",
              "x",
              "y",
              "width",
              "height",
              "visible",
              "settings",
              "blocks"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "visible": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "blocks": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "width",
        "height",
        "sceneId",
        "sceneName",
        "configRevision",
        "layoutRevision",
        "widgets"
      ]
    }
  },
  "required": [
    "screenId",
    "preset",
    "publicRevision",
    "sessionId",
    "mode",
    "leaseMs",
    "publishedAt",
    "content"
  ],
  "$defs": {
    "Now": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "detail": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "enum": [
            "preparing",
            "in_progress",
            "blocked",
            "paused",
            "complete"
          ]
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "status"
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "kind": {
          "enum": [
            "topic",
            "progress",
            "decision",
            "result",
            "correction"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "tentative"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "occurredAt",
        "certainty"
      ]
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "expiresAt"
      ]
    },
    "Work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "publicResult": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "publicResult"
      ]
    },
    "PublicContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "enum": [
            "prepared",
            "active",
            "paused",
            "ended"
          ]
        },
        "goal": {
          "type": "string",
          "maxLength": 300
        },
        "now": {
          "anyOf": [
            {
              "$ref": "#/$defs/Now"
            },
            {
              "type": "null"
            }
          ]
        },
        "recap": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "events": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "pin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "workItem": {
          "anyOf": [
            {
              "$ref": "#/$defs/Work"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "status",
        "now"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "preset": {
            "const": "lower"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "status": {
                    "enum": [
                      "prepared",
                      "active",
                      "paused",
                      "ended"
                    ]
                  },
                  "now": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "title": {
                            "type": "string",
                            "maxLength": 48
                          },
                          "status": {
                            "enum": [
                              "preparing",
                              "in_progress",
                              "blocked",
                              "paused",
                              "complete"
                            ]
                          }
                        },
                        "required": [
                          "title",
                          "status"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "title",
                  "status",
                  "now"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "hidden"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "null"
          },
          "sessionId": {
            "type": "null"
          },
          "overlay": {
            "type": "object",
            "properties": {
              "widgets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "blocks": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
