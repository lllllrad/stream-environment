{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://broadcast.local/contracts/change-set.schema.json",
  "title": "ChangeSet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "intent": {
      "enum": [
        "apply",
        "propose"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disclosure": {
          "enum": [
            "public",
            "unknown",
            "restricted"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9:_-]+$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "disclosure",
        "observedAt",
        "sourceRefs",
        "reason"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "update_session"
              },
              "fields": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "recap": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                },
                "required": [],
                "minProperties": 1
              }
            },
            "required": [
              "op",
              "fields"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "set_now"
              },
              "value": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/now"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "op",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "set_pin"
              },
              "value": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/pin"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "op",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "upsert_event"
              },
              "event": {
                "$ref": "#/$defs/event"
              }
            },
            "required": [
              "op",
              "event"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "retract_event"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "required": [
              "op",
              "id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "upsert_work_item"
              },
              "workItem": {
                "$ref": "#/$defs/work"
              }
            },
            "required": [
              "op",
              "workItem"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "retract_work_item"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "required": [
              "op",
              "id"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "sessionId",
    "baseRevision",
    "intent",
    "provenance",
    "operations"
  ],
  "$defs": {
    "now": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "preparing",
            "in_progress",
            "blocked",
            "paused",
            "complete"
          ]
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "detail",
        "status",
        "next"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "kind": {
          "enum": [
            "topic",
            "progress",
            "decision",
            "result",
            "correction"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "tentative"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "occurredAt",
        "certainty"
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "publicResult": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "publicResult"
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "expiresAt"
      ]
    }
  }
}
