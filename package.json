{
  "name": "broadcast-activity-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/build.mjs && node --watch --env-file-if-exists=.env src/server/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "soak": "node scripts/soak.ts",
    "contracts": "node scripts/generate-contracts.mjs",
    "mcp": "node --env-file-if-exists=.env scripts/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
